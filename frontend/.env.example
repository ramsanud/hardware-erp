# Leave empty to use the Vite dev proxy at /api (recommended: keeps the
# refresh cookie same-site). Set only when the API is on another origin.
VITE_API_BASE_URL=

# CR-076 - the address map picker. Both default to the public OpenStreetMap
# services, which need no key. Set these only for a self-hosted Nominatim /
# tile server (an installation without internet access, or one that outgrows
# OSM's one-request-per-second usage policy).
VITE_GEOCODER_URL=
VITE_MAP_TILE_URL=
