# =====================================================================
# Hardware ERP - self-hosted installation (CR-059)
#
#   cp .env.selfhosted.example .env
#   # fill in the five REQUIRED values below
#   docker compose -f docker-compose.selfhosted.yml up -d
#
# Compose reads `.env` from this directory automatically. Keep that file out
# of version control - it holds the database password and the token signing
# secrets, and anyone with the JWT secret can forge a session for any user.
# =====================================================================

# ---------------------------------------------------------------------
# REQUIRED - the stack refuses to start without these
# ---------------------------------------------------------------------

# Database password. Any long random string; nothing but the containers on
# this machine ever uses it, and the port is not published.
#   openssl rand -base64 24
DB_PASSWORD=

# Token signing secrets. 32 bytes minimum, base64. Generate SEPARATELY - the
# Platform Admin Console is a different trust boundary from the shop app, and
# reusing one value would let a token from either side be replayed at the
# other.
#   openssl rand -base64 32     (run it twice)
JWT_SECRET=
PLATFORM_ADMIN_JWT_SECRET=

# The first OWNER account, created once on first boot. There is no
# self-registration in this product by design (CR-008), so without these
# nobody can sign in at all.
#
# Set APP_BOOTSTRAP_ENABLED=false and `docker compose ... up -d` again once
# you have signed in and changed the password.
# Comments stay on their own lines, never after the `=`. Docker Compose reads
# everything after the `=` as the value, so "APP_BOOTSTRAP_MOBILE=  # 10 digits"
# would set the owner's mobile number to the literal text "# 10 digits".
APP_BOOTSTRAP_ENABLED=true

# 10 digits, no +91.
APP_BOOTSTRAP_MOBILE=

APP_BOOTSTRAP_EMAIL=

# Change it immediately after the first sign-in.
APP_BOOTSTRAP_PASSWORD=

APP_BOOTSTRAP_NAME="Shop Owner"

# ---------------------------------------------------------------------
# How the shop reaches this machine
# ---------------------------------------------------------------------

# The address staff will type. Use the machine's LAN IP, not localhost -
# localhost works only ON this machine, and the point of self-hosting is that
# the counter PC, the billing desk and the owner's laptop all reach it.
#
# Find it with:  ipconfig  (Windows)  /  ip addr  (Linux)
# Give this machine a static or DHCP-reserved address, or the URL changes
# under everyone the next time the router reboots.
APP_BASE_URL=http://192.168.1.10

# Host port for the web UI. 80 lets staff type the bare IP. Change it if
# something already owns 80 on this machine (IIS, Skype, another web app) -
# then the address becomes http://192.168.1.10:8090
WEB_PORT=80

# Leave false while this is plain http on a LAN. A Secure cookie is never
# returned by a browser over http, and the symptom is a sign-in that succeeds
# and instantly bounces back to the login page.
#
# Set true ONLY once there is real HTTPS in front of this (a reverse proxy
# with a certificate, or a VPN/Tailscale address). Until then the refresh
# token crosses the shop LAN unencrypted - acceptable on a private wired
# network, not on shared or guest wifi.
COOKIE_SECURE=false

# ---------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------

# Shown in the startup banner and to support. Helps when one supplier looks
# after several shops.
APP_INSTALLATION_NAME=

# Database name and user. Only meaningful on a FIRST start against an empty
# volume - changing them afterwards does not rename anything, it just points
# the app at a user that does not exist.
DB_NAME=hardware_erp
DB_USER=hardware_erp

# Email. Entirely optional: with it unset, password-reset links are written to
# the container log instead of sent, and the owner can still reset any staff
# password from the Users screen. For Gmail this must be an App Password, not
# the account password.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# JVM ceiling for the API container. The default assumes a shared shop PC.
# On a dedicated server with 8GB+, -XX:MaxRAMPercentage=75 -XX:+UseG1GC is a
# better fit.
JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+UseSerialGC

TZ=Asia/Kolkata

# ---------------------------------------------------------------------
# Deliberately absent
# ---------------------------------------------------------------------
# RAZORPAY_*  - subscription billing does not apply to a self-hosted licence;
#               application-selfhosted.yml forces it off and the checkout
#               endpoint answers 503 BILLING_NOT_APPLICABLE (CR-059).
# WHATSAPP_*  - each tenant connects their own WhatsApp Business account from
#               Settings, never through app-wide configuration (CR-056).
# GEMINI/ANTHROPIC_API_KEY - the AI assistant needs an internet connection and
#               a key of your own; add it here only if you want that feature.
