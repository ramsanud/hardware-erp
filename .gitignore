# =====================================================================
# Secrets - never commit. See .env.example for the template.
# =====================================================================
.env
*.env
.env.local
.env.*.local
!.env.example
!frontend/.env.example

# Per-developer Spring overrides. application-local.yml is committed as a
# template; anything with a real secret in it must use this name instead.
application-local-secret.yml
application-*-secret.yml

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
id_rsa*

# =====================================================================
# Build output
# =====================================================================
backend/target/
target/
frontend/node_modules/
node_modules/
frontend/dist/
dist/
*.tsbuildinfo

# =====================================================================
# Local data - never belongs in the repository
# =====================================================================
# scripts/backup-db.sh output: contains real customer data
backups/

# =====================================================================
# IDE / OS
# =====================================================================
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
Thumbs.db
.DS_Store

# =====================================================================
# Logs and JVM crash dumps
# =====================================================================
*.log
hs_err_pid*.log
replay_pid*.log

# Compiled class files. Kept from the GitHub Java template that was merged

# in at 52e2aee; the rest of that template duplicated the sections above and

# was dropped when the conflict was resolved (2026-09-04).

*.class

# =====================================================================

# Deployment env files (CR-059). The .example templates ARE committed;

# the real ones hold the database password and the token signing secrets.

#   .env            docker compose reads this for the self-hosted stack

#   .env.cloud      scripts/run-cloud.* read this for the Supabase stack

# =====================================================================

.env.cloud

.env.selfhosted

# =====================================================================
# Session scratch (2026-09-14). Concurrent Claude sessions drop one-off
# live-smoke scripts and a second Vite config beside the real suites so
# two dev servers can run side by side. They carry local dev passwords
# and paths into a session's temp directory, so they must never be
# swept in by a broad `git add`.
# =====================================================================
frontend/tests/*.tmp.mjs
frontend/tests/.tmp-*
frontend/vite.config.audit.ts

# Machine-local artefacts of the verification recipe in .claude/guides
# (architecture.md, testing.md): the empty-config DOCKER_CONFIG dir Git Bash
# needs, and a private Playwright build served on its own port so another
# session's `vite build` cannot rewrite it mid-suite. Neither is a deliverable.
.docker-iso/
frontend/dist-iso/
