# ---------------------------------------------------------------------
# Backend environment. Copy to .env and fill in before running.
# Never commit .env.
# ---------------------------------------------------------------------

# Database (PostgreSQL - CR-014)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=hardware_erp
DB_USER=hardware_erp
DB_PASSWORD=change-me

# JWT signing key. Must decode to at least 32 bytes.
# Generate with:  openssl rand -base64 32
# The application refuses to start under the 'prod' profile with the
# placeholder value baked into application.yml.
JWT_SECRET=

# Frontend origin allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Cookie transport for the refresh token. Set false only for local http.
COOKIE_SECURE=true

# First-run owner account. Disabled by default; production never creates
# an account silently. Password must be >=12 chars with upper, lower and digit.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_MOBILE=
APP_BOOTSTRAP_EMAIL=
APP_BOOTSTRAP_PASSWORD=
APP_BOOTSTRAP_NAME=Shop Owner

# SMTP for password reset links. Leave blank in dev; the link is logged instead.
# MAIL_USER/MAIL_PASSWORD: Gmail requires a 16-character App Password
# (myaccount.google.com/apppasswords, needs 2-Step Verification on) - a
# regular account password will fail SMTP auth.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
RESET_URL=http://localhost:5173/reset-password

# Twilio SMS (CR-074). OFF unless SMS_ENABLED=true (CR-077): SMS is a paid
# channel with no free tier, so the auth and notification stack runs on
# email and SMS is opt-in. Off or blank = every SMS is logged instead of sent. India: register a DLT sender id and use the
# Messaging Service SID - a bare TWILIO_FROM_NUMBER gets accepted by Twilio
# and then dropped by the Indian operator.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Email provider (CR-074, CR-077): smtp (default, uses MAIL_* above),
# sendgrid, or resend. Switching this moves EVERY email - notifications,
# password-reset links, sign-in codes, invoice PDFs and the Settings
# test-email button - onto that provider. Resend has a free tier (3,000 a
# month) and is the recommended choice for a new deployment.
# The from address must be a sender/domain the provider has verified, or
# it answers 403 however valid the key is.
EMAIL_PROVIDER=smtp
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=


# AES-256-GCM key for supplier bank account encryption at rest (CR-018).
# Generate with:  openssl rand -base64 32
# Losing this key makes every already-encrypted bank_account_no value
# undecryptable garbage - back it up somewhere durable, not just a shell
# session. Blank = FieldEncryptor falls back to plaintext passthrough.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# Environment selection
# ---------------------------------------------------------------------
# Which Spring profile the backend runs under: local | dev | test | prod.
# Defaults to 'dev' when unset (application.yml). Anything deployed for real
# users must be 'prod' - it is the only profile that disables the API
# browser, forces developer inspection off and refuses the placeholder
# JWT_SECRET.
SPRING_PROFILES_ACTIVE=local

# Developer inspection (CR-045). Environment half of the gate only; the
# DEVELOPER_INSPECT permission is the other half and is granted per user.
# Ignored under the 'prod' profile, which forces it off server-side.
APP_DEVELOPER_INSPECTION_ENABLED=false

# ---------------------------------------------------------------------
# Frontend (frontend/.env.local - Vite only exposes VITE_-prefixed vars)
# ---------------------------------------------------------------------
# Leave blank to use the Vite dev proxy at /api, which keeps the refresh
# cookie same-site. Set only when the API is on another origin.
# VITE_API_BASE_URL=
