# ---------------------------------------------------------------------
# Backend environment. Copy to .env and fill in before running.
# Never commit .env.
# ---------------------------------------------------------------------

# Database (PostgreSQL - CR-014)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hardware_erp
DB_USER=hardware_erp
DB_PASSWORD=change-me

# JWT signing key. Must decode to at least 32 bytes.
# Generate with:  openssl rand -base64 32
# The application refuses to start under the 'prod' profile with the
# placeholder value baked into application.yml.
JWT_SECRET=

# Frontend origin allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Cookie transport for the refresh token. Set false only for local http.
COOKIE_SECURE=true

# First-run owner account. Disabled by default; production never creates
# an account silently. Password must be >=12 chars with upper, lower and digit.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_MOBILE=
APP_BOOTSTRAP_EMAIL=
APP_BOOTSTRAP_PASSWORD=
APP_BOOTSTRAP_NAME=Shop Owner

# SMTP for password reset links. Leave blank in dev; the link is logged instead.
# MAIL_USER/MAIL_PASSWORD: Gmail requires a 16-character App Password
# (myaccount.google.com/apppasswords, needs 2-Step Verification on) - a
# regular account password will fail SMTP auth.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
RESET_URL=http://localhost:5173/reset-password

# AES-256-GCM key for supplier bank account encryption at rest (CR-018).
# Generate with:  openssl rand -base64 32
# Losing this key makes every already-encrypted bank_account_no value
# undecryptable garbage - back it up somewhere durable, not just a shell
# session. Blank = FieldEncryptor falls back to plaintext passthrough.
APP_ENCRYPTION_KEY=
