# =====================================================================
# Hardware ERP - running against Supabase (CR-059, CLOUD mode)
#
#   cp .env.cloud.example .env.cloud
#   # fill in the values marked REQUIRED
#   ./scripts/run-cloud.sh          (Git Bash)
#   .\scripts\run-cloud.ps1         (PowerShell)
#
# IMPORTANT: Spring Boot does NOT read .env files - there is no dotenv
# library in this project. The run-cloud scripts exist precisely to close
# that gap: they read this file and export it as real environment
# variables before starting the app. Deploying to Render instead? Then
# this file is not used at all - set the same keys in the Render
# dashboard (render.yaml declares them).
#
# .env.cloud is gitignored. Never commit it: it holds the database
# password and both token signing secrets.
# =====================================================================

# ---------------------------------------------------------------------
# REQUIRED - Supabase connection
#
# Supabase dashboard -> Project Settings -> Database -> Connection string
# -> choose "Session pooler" (NOT "Transaction pooler").
#
# Why the session pooler: transaction-mode pooling breaks server-side
# prepared statements and per-session state, and DocumentSequenceService
# holds SELECT ... FOR UPDATE for the caller's transaction (CR-041).
# Session pooler is port 5432; transaction pooler is 6543 - do not use it.
# ---------------------------------------------------------------------

# Host only - no jdbc:, no port, no database name.
# Looks like: aws-0-ap-south-1.pooler.supabase.com
DB_HOST=

# Looks like: postgres.abcdefghijklmnop  (note the dot - it is not just "postgres")
DB_USER=

# The database password you set when the project was created. If you have
# lost it: Project Settings -> Database -> Reset database password.
DB_PASSWORD=

# Defaults already match Supabase, so leave these alone unless yours differ.
# DB_PORT=5432
# DB_NAME=postgres

# ---------------------------------------------------------------------
# REQUIRED - token signing secrets
#
# Generate TWO DIFFERENT values:
#
#   Git Bash    openssl rand -base64 32          (run it twice)
#   PowerShell  .\scripts\new-secret.ps1 -Count 2
#
# openssl is bundled with Git for Windows but is NOT on PowerShell's PATH,
# which is why the second form exists. Both produce 32 random bytes,
# base64 encoded, from the OS cryptographic RNG.
#
# They must differ. The Platform Admin Console is a separate trust
# boundary from the shop application (CR-054); one shared value would let
# a token minted on either side be replayed against the other.
#
# The app refuses to start in prod on the built-in placeholder values.
# ---------------------------------------------------------------------
JWT_SECRET=
PLATFORM_ADMIN_JWT_SECRET=

# ---------------------------------------------------------------------
# REQUIRED on the first run only - creates the first OWNER account
#
# There is no self-registration endpoint by design (CR-008), so without
# these nobody can sign in to a fresh database at all.
#
# Set APP_BOOTSTRAP_ENABLED=false and restart once you have signed in and
# changed the password.
# ---------------------------------------------------------------------
# Comments stay on their own lines, never after the `=`. A trailing comment on
# a blank key ("APP_BOOTSTRAP_MOBILE=   # 10 digits") is read as a VALUE by
# some env parsers, so the app would start with "# 10 digits" as its owner
# mobile number.
APP_BOOTSTRAP_ENABLED=true

# 10 digits, no +91.
APP_BOOTSTRAP_MOBILE=

APP_BOOTSTRAP_EMAIL=

# Change it immediately after the first sign-in.
APP_BOOTSTRAP_PASSWORD=

APP_BOOTSTRAP_NAME="Shop Owner"

# ---------------------------------------------------------------------
# Where the browser reaches the app
#
# Defaults below suit running the backend locally against Supabase, with
# `npm run dev` serving the frontend - Vite proxies /api to localhost:8080,
# so the request is same-origin and CORS never comes into it.
#
# Deploying the frontend to Vercel instead? Point both at that origin:
#   CORS_ORIGINS=https://your-app.vercel.app
#   RESET_URL=https://your-app.vercel.app/reset-password
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
RESET_URL=http://localhost:5173/reset-password

# ---------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------

# Shown in the startup banner and to support.
APP_INSTALLATION_NAME=

# CR-060 - two-factor authentication.
#
# Leave this out (or set true) and sign-in requires the CR-058 second factor:
# an authenticator app, enrolled on first login, with one-time backup codes.
#
# MFA_REQUIRED=false makes a correct identifier + password sign in directly.
# Nothing is deleted by that - enrollment, TOTP verification and backup codes
# all still exist and return the moment it is true again - but a leaked or
# guessed password is then sufficient on its own, so it is meant for
# development, not for an installation holding a real shop's data. The startup
# banner prints "mfa: *** DISABLED ***" on every boot while it is off.
# MFA_REQUIRED=false

# Email. Entirely optional: unset, password-reset links are logged instead
# of sent, and the owner can still reset any staff password from Users.
# For Gmail this must be an App Password, not the account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# Supabase's free tier caps connections tightly and the session pooler
# grants fewer than PostgreSQL's own max_connections suggests. The cloud
# profile defaults to 10; drop it if you see pool timeouts.
# DB_POOL_SIZE=10

# ---------------------------------------------------------------------
# Deliberately absent
# ---------------------------------------------------------------------
# COOKIE_SECURE - application-cloud.yml pins it true with no placeholder.
#                 The hosted product is HTTPS-only and the refresh token is
#                 a 7-day credential. Setting it here would do nothing.
# DB_SSL_MODE   - defaults to 'require' in cloud mode, which is what
#                 Supabase needs. Only change it for a different provider.
# RAZORPAY_*    - only needed if you are actually taking subscription
#                 payments; billing returns an honest 503 until then.
